
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/styleOne.css">
    <title>Register</title>
</head>
<body>
    <div class="container">
        <div class="head">
        <h2>Create Account</h2>
        </div><br><br>
        <form action="/register" method="post">
            <table>
            <tr>
            <td>Name:</td><td><input type="text" placeholder="Enter Name" name="username" required></td>
            </tr>
            <tr>
            <td>Email:</td><td><input type="email" placeholder="Enter Email" name="email" required></td>
            </tr>
            <td>password:</td><td><input type="password" placeholder="Enter Password" name="password" required></td>
            </table>
            <button type="submit">Register</button>
            <p>Already have an account?<a href="/login">Login</a></p>
        </form>

    </div>
</body>
</html>